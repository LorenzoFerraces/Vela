# Vela — docker-compose environment
#
# Copy to `.env` (same directory as docker-compose.yml) and edit:
#   cp .env.example .env
#
# `docker compose` interpolates ${VAR} from this file, and the `api` service
# receives every value here as an environment variable. Variables the app
# does not read are ignored.

# ============================= Required =============================

# Signs JWT access tokens. Use a long random string; changing it invalidates
# every existing session. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VELA_AUTH_SECRET=

# Fernet key that encrypts third-party tokens (e.g. GitHub OAuth) at rest.
# Changing it makes stored tokens unreadable. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VELA_TOKEN_ENCRYPTION_KEY=

# ======================= Postgres (compose service) =======================

# Credentials for the bundled postgres service; the API's database URL is
# built from these in docker-compose.yml (host/port are fixed by compose).
# The first `up` initializes the DB with these values — changing them later
# requires deleting the postgres_data volume.
POSTGRES_USER=vela
POSTGRES_PASSWORD=vela
POSTGRES_DB=Vela

# ========================= Docker daemon access =========================

# Host path of the Docker socket the API uses to create/manage workload
# containers. Keep the default on Linux/WSL2. On Windows Docker Desktop the
# mount may fail from a Windows shell — run compose from a WSL2 distro
# (path is the same there) or point this at your daemon's socket.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# GID of the host docker group that owns the socket. The api image runs as a
# non-root user in that group; if your host uses a non-default GID, set this
# and rebuild the api image (docker compose up -d --build api). On Windows
# Docker Desktop the socket arrives as root:root, so the api entrypoint aligns
# its group to this value automatically at container start.
DOCKER_GROUP_ID=999

# ============================ Frontend build ============================

# Optional API origin baked into the SPA at build time (rebuild `web` after
# changing: docker compose up -d --build web). Leave empty (recommended): /api
# and WebSocket traffic then flow same-origin through the built-in nginx
# proxy, which works for any deployment URL. Set it only when the SPA is
# served from a different origin than the API.
VITE_API_BASE_URL=

# Host port for direct SPA access (bypasses Traefik). The public entrypoint
# is always port 80 via Traefik.
VELA_WEB_PORT=8081

# ======================= Public routes (Traefik) ========================

# How Vela publishes container routes: noop (no public hostnames),
# traefik_file (writes a dynamic JSON file consumed by the traefik service),
# or kubernetes (scaffold).
VELA_TRAFFIC_ROUTER=traefik_file

# Base domain for generated public hostnames, e.g. apps.example.com.
# Leave empty to disable public hostnames (routes stay cluster-local).
# DNS for this domain (or a wildcard) must point at the machine running
# Traefik for hostnames to resolve.
VELA_PUBLIC_ROUTE_DOMAIN=

# http or https — the scheme used in generated public URLs. Only use https
# once TLS is actually terminated in front of Traefik (e.g. letsencrypt).
VELA_PUBLIC_URL_SCHEME=http

# Prefix for generated hostnames: {prefix}{name}.{VELA_PUBLIC_ROUTE_DOMAIN}
VELA_PUBLIC_ROUTE_HOST_PREFIX=vela-

# ============================= OAuth flows =============================

# Where the browser returns after GitHub OAuth connect/disconnect.
# Default matches the compose stack's port 80 entrypoint.
VELA_FRONTEND_BASE_URL=http://localhost

# GitHub OAuth App credentials — needed only for private repo deploys and the
# GitHub picker. Register the app at github.com/settings/developers and set
# its Authorization callback URL to VELA_GITHUB_OAUTH_REDIRECT_URI below.
VELA_GITHUB_CLIENT_ID=
VELA_GITHUB_CLIENT_SECRET=
# Public URL of GET /api/auth/github/callback (served through port 80 here).
VELA_GITHUB_OAUTH_REDIRECT_URI=http://localhost/api/auth/github/callback
# Comma-separated scopes requested from GitHub.
VELA_GITHUB_OAUTH_SCOPES=repo,read:user

# Clerk sign-in (optional, disabled when empty).
VELA_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (Dashboard -> API Keys). Only needed when your session token
# has no email claim: the API then resolves the account's email via Clerk's
# Users API. Server-side only — never exposed to the SPA.
VELA_CLERK_SECRET_KEY=
# Restricts the azp (authorized party) claim on Clerk tokens: comma-separated
# origins allowed to exchange tokens. When empty, any azp is accepted.
VELA_ALLOWED_ORIGINS=

# ========================= Object storage (avatars) =====================

# memory = in-process storage, LOST when the api container restarts (fine for
# trialing); r2 = Cloudflare R2 (all VELA_R2_* variables become required).
VELA_OBJECT_STORAGE=memory

# Only used with VELA_OBJECT_STORAGE=memory: base URL used to render stored
# objects (default https://storage.test when empty).
VELA_OBJECT_STORAGE_PUBLIC_BASE_URL=

# R2 settings — required only when VELA_OBJECT_STORAGE=r2.
VELA_R2_ACCOUNT_ID=
VELA_R2_ACCESS_KEY_ID=
VELA_R2_SECRET_ACCESS_KEY=
VELA_R2_BUCKET=
# Public base URL (CDN or custom domain, no trailing slash) for stored objects.
VELA_R2_PUBLIC_BASE_URL=

# ==================== GitHub repo analysis (LLM, optional) ==============

# Google Gemini key for repo analysis (pre-fills container forms). Without it,
# analysis falls back to deterministic detection only.
VELA_GEMINI_API_KEY=
# Gemini model id.
VELA_GEMINI_MODEL=gemini-2.0-flash
# When BOTH key and project id are set, Vertex AI is used instead of direct
# Gemini.
VELA_VERTEX_API_KEY=
VELA_VERTEX_PROJECT_ID=
VELA_VERTEX_LOCATION=us-central1
VELA_VERTEX_MODEL=gemini-2.5-flash

# ====================== Container alert emails (Brevo) ===================

# Transactional email for container down/restart alerts. Disabled when
# BREVO_API_KEY is empty. BREVO_SENDER_EMAIL must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Vela

# ========================= Logs, exec, streams ==========================

# App + uvicorn log level: DEBUG, INFO, WARNING, ERROR.
VELA_LOG_LEVEL=INFO

# Set 0 to skip the app's logging setup (uvicorn keeps its own logging).
VELA_CONFIGURE_LOGGING=1

# Max length of a live exec (terminal) session in seconds.
VELA_EXEC_MAX_SESSION_SECONDS=3600

# Max concurrent container log-stream WebSockets served by the API.
VELA_MAX_LOG_STREAMS=64

# Background collector that stores container logs in the database so the Logs
# page has history. Set VELA_LOG_COLLECTOR_ENABLED=0 to disable.
VELA_LOG_COLLECTOR_ENABLED=1
# Poll interval (seconds) for the log collector.
VELA_LOG_COLLECTOR_INTERVAL_SECONDS=5
# Max log lines pulled per batch per poll cycle.
VELA_LOG_BATCH_SIZE=100
# How long collected logs are kept in the database (days).
VELA_LOG_RETENTION_DAYS=7
# Max log lines pulled per container per poll.
VELA_LOG_MAX_LINES_PER_POLL=2000

# ======================== Container health alerts =======================

# Background monitor that checks container health and raises alerts.
# Set VELA_CONTAINER_MONITOR_ENABLED=0 to disable.
VELA_CONTAINER_MONITOR_ENABLED=1
# Poll interval (seconds) for the monitor.
VELA_CONTAINER_MONITOR_INTERVAL_SECONDS=15
# How many trailing log lines are attached to an alert.
VELA_ALERT_LOG_TAIL_LINES=200

# ============================ Auth session ==============================

# Access token lifetime in minutes (sensible default when empty).
VELA_AUTH_ACCESS_TOKEN_TTL_MINUTES=

# ===================== Builds, uploads, quotas ==========================

# Restrict server-side build paths to this directory (optional; empty = no
# restriction). Only relevant for building from server paths.
VELA_ALLOWED_BUILD_ROOT=

# Where folder uploads are stored INSIDE the api container; compose backs the
# parent directory with the uploads_data volume so uploads survive restarts.
# Do not point this outside /data unless you add a matching volume.
VELA_VOLUME_UPLOADS_DIR=/data/volume-uploads

# Max size of a single uploaded folder (bytes; default 100 MiB).
VELA_VOLUME_UPLOAD_MAX_BYTES=104857600
# Max total upload size per user (bytes; default 150 MiB).
VELA_VOLUME_UPLOAD_USER_QUOTA_BYTES=157286400

# ========================== Dev / test only =============================
# NEVER enable these in a real deployment.

# Swap the real Docker orchestrator for an in-memory fake (unit tests/E2E).
VELA_FAKE_ORCHESTRATOR=0

# E2E mode: seed demo users, mock GitHub, allow DB reset.
VELA_E2E=0
# Required alongside VELA_E2E=1 to permit schema drop+create.
VELA_E2E_ALLOW_DB_RESET=0
