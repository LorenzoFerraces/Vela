# Shell scripts are executed inside Linux images; CRLF checkouts (autocrlf
# machines) break them at runtime (e.g. `set: Illegal option -`).
*.sh text eol=lf
# Configs and build files consumed by Linux containers/tools; force LF even on autocrlf clones.
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
