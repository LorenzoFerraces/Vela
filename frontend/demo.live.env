# Live demo credentials for `npm run demo:record:live`
# (Playwright loads this file automatically. Do not put these in backend/.env.)

VELA_DEMO_EMAIL=lorenzoferraces@gmail.com
VELA_DEMO_PASSWORD=lf131019

# Git analyze scene — search is matched against repo *name* (not a full github.com URL)
VELA_DEMO_GIT_SEARCH=unq-ui-Lorenzo-Ferraces-trabajo-final
VELA_DEMO_GIT_OPTION=unq-ui-Lorenzo-Ferraces-trabajo-final
VELA_DEMO_GITHUB_LOGIN=Lorenzoferraces

# Skip extra stopped-container seed (faster)
VELA_DEMO_SKIP_STOPPED_SEED=1

# Optional: skip Git analyze if clone/Gemini is too slow for a 5–7 min cut
# VELA_DEMO_SKIP_GIT=1
